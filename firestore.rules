
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDataOwner(resource) {
      return isSignedIn() && resource.data.companyId == request.auth.uid;
    }

    function isNewDataOwner() {
      return isSignedIn() && request.resource.data.companyId == request.auth.uid;
    }

    match /employees/{employeeId} {
      allow read, update, delete: if isDataOwner(resource);
      allow create: if isNewDataOwner();
    }

    match /payrollRecords/{payrollRecordId} {
      allow read, update, delete: if isDataOwner(resource);
      allow create: if isNewDataOwner();
    }
  }
}
