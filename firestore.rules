
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDataOwner(resource) {
      return isSignedIn() && resource.data.companyId == request.auth.uid;
    }

    function isNewDataOwner() {
      return isSignedIn() && request.resource.data.companyId == request.auth.uid;
    }

    match /employees/{employeeId} {
      allow read, delete: if isDataOwner(resource);
      
      allow create: if isNewDataOwner()
        && request.resource.data.fullName is string
        && (request.resource.data.totalPaidLeave == null || request.resource.data.totalPaidLeave is number)
        && (request.resource.data.usedPaidLeave == null || request.resource.data.usedPaidLeave >= 0);
        
      allow update: if isDataOwner(resource) 
        && request.resource.data.companyId == resource.data.companyId
        && (request.resource.data.usedPaidLeave == null || request.resource.data.usedPaidLeave >= 0);
    }

    match /payrollRecords/{payrollRecordId} {
      allow read, delete: if isDataOwner(resource);
      
      allow create: if isNewDataOwner()
        && request.resource.data.employeeId is string
        && request.resource.data.country is string;

      allow update: if isDataOwner(resource)
        && request.resource.data.companyId == resource.data.companyId;
    }

    match /companyCalendars/{calendarId} {
      allow read, delete: if isDataOwner(resource);
      allow create, update: if isNewDataOwner();
    }
  }
}
