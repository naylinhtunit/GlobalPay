{
  "entities": {
    "Employee": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Employee",
      "type": "object",
      "description": "Represents an individual employee with their core personal and employment details within the GlobalPay system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Employee entity."
        },
        "employeeNumber": {
          "type": "string",
          "description": "A unique identifier assigned to the employee within the organization."
        },
        "fullName": {
          "type": "string",
          "description": "The employee's full legal name."
        },
        "email": {
          "type": "string",
          "description": "The employee's professional email address.",
          "format": "email"
        },
        "baseSalary": {
          "type": "number",
          "description": "The fundamental base salary amount for the employee."
        },
        "country": {
          "type": "string",
          "description": "The primary country of employment (e.g., 'Japan', 'Myanmar')."
        },
        "hireDate": {
          "type": "string",
          "description": "The official date when the employee commenced employment.",
          "format": "date"
        },
        "department": {
          "type": "string",
          "description": "The department or organizational unit to which the employee is assigned."
        }
      },
      "required": [
        "id",
        "employeeNumber",
        "fullName",
        "country",
        "hireDate",
        "baseSalary"
      ]
    },
    "PayrollRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PayrollRecord",
      "type": "object",
      "description": "Represents a single monthly payroll record for a specific employee.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the PayrollRecord entity."
        },
        "employeeId": {
          "type": "string",
          "description": "Reference to the Employee entity."
        },
        "payPeriodStartDate": {
          "type": "string",
          "description": "Start date of the payroll period.",
          "format": "date-time"
        },
        "payPeriodEndDate": {
          "type": "string",
          "description": "End date of the payroll period.",
          "format": "date-time"
        },
        "payoutDate": {
          "type": "string",
          "description": "Date of disbursement.",
          "format": "date-time"
        },
        "country": {
          "type": "string",
          "description": "Country context."
        },
        "basicSalary": {
          "type": "number",
          "description": "Base salary for the period."
        },
        "status": {
          "type": "string",
          "description": "Processing status."
        },
        "totalGrossPay": {
          "type": "number",
          "description": "Total earnings before deductions."
        },
        "totalDeductions": {
          "type": "number",
          "description": "Total deductions."
        },
        "netPay": {
          "type": "number",
          "description": "Final take-home pay."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "employeeId",
        "payPeriodStartDate",
        "payPeriodEndDate",
        "payoutDate",
        "country",
        "basicSalary",
        "status",
        "totalGrossPay",
        "totalDeductions",
        "netPay"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/employees/{employeeId}",
        "definition": {
          "entityName": "Employee",
          "schema": {
            "$ref": "#/backend/entities/Employee"
          },
          "description": "Stores individual employee profiles."
        }
      },
      {
        "path": "/employees/{employeeId}/payrollRecords/{payrollRecordId}",
        "definition": {
          "entityName": "PayrollRecord",
          "schema": {
            "$ref": "#/backend/entities/PayrollRecord"
          },
          "description": "Monthly payroll records."
        }
      }
    ]
  }
}
