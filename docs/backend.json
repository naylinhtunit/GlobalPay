
{
  "entities": {
    "Employee": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Employee",
      "type": "object",
      "description": "Represents an individual employee with their core personal and employment details and historical records.",
      "properties": {
        "id": {
          "type": "string"
        },
        "companyId": {
          "type": "string"
        },
        "employeeNumber": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "baseSalary": {
          "type": "number",
          "description": "Latest or current base salary."
        },
        "salaryHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "amount": { "type": "number" },
              "effectiveMonth": { "type": "string", "description": "Format YYYY-MM" }
            }
          }
        },
        "country": {
          "type": "string"
        },
        "hireDate": {
          "type": "string",
          "format": "date"
        },
        "department": {
          "type": "string"
        },
        "totalPaidLeave": {
          "type": "number",
          "description": "Annual allowance of paid leave days."
        },
        "salaryCurrency": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "companyId",
        "employeeNumber",
        "fullName",
        "country",
        "hireDate",
        "baseSalary"
      ]
    },
    "PayrollRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PayrollRecord",
      "type": "object",
      "description": "Represents a single monthly payroll record for a specific employee.",
      "properties": {
        "id": {
          "type": "string"
        },
        "companyId": {
          "type": "string"
        },
        "employeeId": {
          "type": "string"
        },
        "payPeriodStartDate": {
          "type": "string",
          "format": "date-time"
        },
        "payPeriodEndDate": {
          "type": "string",
          "format": "date-time"
        },
        "payoutDate": {
          "type": "string",
          "format": "date-time"
        },
        "country": {
          "type": "string"
        },
        "basicSalary": {
          "type": "number",
          "description": "The base salary at the time this payroll was calculated."
        },
        "status": {
          "type": "string"
        },
        "totalGrossPay": {
          "type": "number"
        },
        "totalDeductions": {
          "type": "number"
        },
        "netPay": {
          "type": "number"
        },
        "paidLeaveDays": {
          "type": "number",
          "description": "Number of paid leave days taken in this specific month."
        },
        "japanData": {
          "type": "object"
        },
        "myanmarData": {
          "type": "object"
        }
      },
      "required": [
        "companyId",
        "employeeId",
        "payPeriodStartDate",
        "payoutDate",
        "country",
        "basicSalary",
        "status",
        "totalGrossPay",
        "totalDeductions",
        "netPay"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/employees/{employeeId}",
        "definition": {
          "entityName": "Employee",
          "schema": {
            "$ref": "#/backend/entities/Employee"
          }
        }
      },
      {
        "path": "/payrollRecords/{payrollRecordId}",
        "definition": {
          "entityName": "PayrollRecord",
          "schema": {
            "$ref": "#/backend/entities/PayrollRecord"
          }
        }
      }
    ]
  }
}
